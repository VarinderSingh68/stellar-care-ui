# Publicly served media (testimonials, images, video). The API only ever writes
# image/video files here, and nothing in this folder may ever execute.

Options -Indexes

<FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8|inc|cgi|pl|py|sh|html?|svg)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
