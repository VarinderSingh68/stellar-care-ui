# Clinic data: JSON collections, generated prescription PDFs, session secret.
# Nothing in here may ever be served over HTTP -- the API is the only reader.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

Options -Indexes
