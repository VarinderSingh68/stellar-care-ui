# Dependencies & build output (any folder)
node_modules
dist
dist-ssr
*.local

# Secrets -- real env files live in env/ (only the *.example templates are
# committed). Also catch a stray .env anywhere.
env/*.env
!env/*.env.example
.env
.env.*

# Backend runtime data: JSON data store, uploaded media and generated PDFs
# (backend/lib/store.cjs and the PHP API). This is data, not source.
backend/data/
backend/data_test/
backend/uploads/
backend-php/data/
backend-php/uploads/

# PHP API secrets -- config.php holds the Resend key and session secret and
# exists only on the server. Only the *.example template is committed.
backend-php/config.php

# Deployment scaffolding produced by the GitHub Actions workflow
deploy-out/

# Local scratch output
.tmp-smoke/

# Logs & scratch files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tgz
*.tmp
*.timestamp-*.mjs

# Editor / tool state
.vscode/*
!.vscode/extensions.json
.idea
.refact/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
