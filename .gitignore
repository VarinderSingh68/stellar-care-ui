# Dependencies & build output (any folder)
node_modules
dist
dist-ssr
*.local

# Secrets -- real env files live in env/ (only the *.example templates are
# committed). Also catch a stray .env anywhere.
env/*.env
!env/*.env.example
.env
.env.*

# Backend runtime data: JSON data store, uploaded media and generated PDFs
# (backend/lib/store.cjs). This is data, not source. On Render, DATA_DIR
# points at a persistent Disk instead (see render.yaml).
backend/data/
backend/data_test/
backend/uploads/

# Logs & scratch files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tgz
*.tmp
*.timestamp-*.mjs

# Editor / tool state
.vscode/*
!.vscode/extensions.json
.idea
.refact/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
