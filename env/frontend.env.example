# Frontend (frontend/, Vite) settings for LOCAL development.
# Copy this file to env/frontend.env if you need to change anything --
# env/frontend.env is gitignored. Only variables starting with VITE_ are
# exposed to the browser, so never put secrets here.

# URL of the backend API. Leave blank in local development to use
# http://localhost:5000 automatically. In production this is set by
# render.yaml (VITE_API_URL on the static site) at build time.
VITE_API_URL=
