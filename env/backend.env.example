# Backend (backend/server.cjs) settings for LOCAL development.
# Copy this file to env/backend.env and fill in the values -- env/backend.env
# is gitignored, never commit it. In production (Render) set these in the
# service's Environment settings instead; this file isn't deployed.

# --- Email (Resend, recommended) ------------------------------------------
# Sign up at https://resend.com, create an API key, and verify a domain you
# own under Domains (adds a couple of DNS records at your registrar) --
# RESEND_FROM_EMAIL must be an address at that verified domain. Without a
# verified domain, Resend's sandbox will only actually deliver mail to the
# address you signed up with, which is fine for testing but not for real
# patients. If RESEND_API_KEY is set, it takes priority over the Gmail
# settings below.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Email (Gmail SMTP via Nodemailer, legacy fallback) --------------------
# Only used when RESEND_API_KEY above is not set. Works for local testing,
# but mail sent from a personal Gmail account to real patient inboxes is
# frequently dropped or spam-filtered -- prefer Resend for anything patients
# actually need to receive. Use a Gmail App Password (not your regular
# Google password): https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be enabled on the account first). Paste the
# 16-character password below with or without spaces -- spaces are
# stripped automatically.
# If nothing above or below is set, the server still starts -- email-sending
# endpoints just report "email is not configured" instead of crashing.
EMAIL_USER=
EMAIL_PASSWORD=
# Where booking/prescription notifications are CC'd.
ADMIN_NOTIFICATION_EMAIL=

PORT=5000
CLINIC_PHONE=91xxxxxxxxxx

# --- Auth / sessions -----------------------------------------------------
# Secret used to sign admin/patient session tokens (HMAC-SHA256). Set this
# explicitly in production -- if left blank, the server generates one on
# first boot and persists it into DATA_DIR, which works but means every
# environment/instance needs its own (and all sessions are invalidated if
# that generated file is ever lost). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Data storage ----------------------------------------------------------
# Directory the JSON data store (patients, appointments, prescriptions,
# uploaded media, etc.) is written to. Relative paths are resolved from the
# backend/ folder, so the default ./data means backend/data.
# IMPORTANT: on Render, a web service's filesystem is EPHEMERAL -- anything
# written here is wiped on every redeploy/restart unless you attach a
# persistent Disk and point DATA_DIR at its mount path (see render.yaml).
DATA_DIR=./data

# --- WATI WhatsApp automation (optional) ------------------------------
# Get these from WATI > API Docs / Developer API. Leave blank to disable --
# WhatsApp sends will be skipped gracefully with a reason, not an error.
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
WATI_CHANNEL_NUMBER=
WATI_DEFAULT_COUNTRY_CODE=91

# Approved WATI template names
WATI_APPOINTMENT_TEMPLATE_NAME=appointment_confirmation
WATI_PRESCRIPTION_TEMPLATE_NAME=prescription_pdf
WATI_APPOINTMENT_BROADCAST_NAME=appointment_confirmation
WATI_PRESCRIPTION_BROADCAST_NAME=prescription_pdf

# Your deployed backend URL. Required for sending prescription PDFs on WhatsApp.
# Example: https://your-clinic-api.onrender.com
PUBLIC_APP_URL=
WATI_PRESCRIPTION_PDF_PARAM_NAME=pdfLink
