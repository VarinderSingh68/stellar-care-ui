# Dr. Rana Dental Clinic -- PHP API (deployed at htdocs/api/)
#
# Everything under /api is handled by index.php; the frontend and the uploads
# folder are served directly by Apache from htdocs.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never expose internals.
  RewriteRule ^lib/ - [F]
  RewriteRule ^scripts/ - [F]
  RewriteRule ^router\.php$ - [F]
  RewriteRule ^config\.php$ - [F]

  # Route everything else to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_authz_core.c>
  <Files "config.php">
    Require all denied
  </Files>
</IfModule>

Options -Indexes
